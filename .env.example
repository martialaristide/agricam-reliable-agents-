# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.

# Clé API Anthropic — requise uniquement pour exécuter AnthropicLLMClient
# (agent réel). Les tests n'en ont jamais besoin (tout est mocké).
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé par l'agent réel (défaut : claude-opus-5)
AGRICAM_MODEL=claude-opus-5

# Chaîne de connexion SQLAlchemy du data store persistant.
# Développement : SQLite local. Production : PostgreSQL, ex.
# postgresql+psycopg://user:password@host:5432/agricam
AGRICAM_DATABASE_URL=sqlite:///agricam.db
